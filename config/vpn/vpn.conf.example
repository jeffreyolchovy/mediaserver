client
dev tun
proto udp
remote <geography>.privacy.network 1198
resolv-retry infinite
nobind
persist-key
persist-tun
cipher aes-128-cbc
auth sha1
tls-client
remote-cert-tls server
auth-user-pass /vpn/vpn.auth
compress
verb 1
reneg-sec 0
ca /vpn/ca.rsa.2048.crt
disable-occ
keepalive 10 30
pull-filter ignore "auth-token"

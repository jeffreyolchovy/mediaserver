TZ=America/New_York

PUID=1000
PGID=1000

ROOT=/mnt/extmedia

# LAN subnet the VPN container should route back to directly (not through
# the tunnel). Without a matching route, LAN clients can't reach the Deluge
# web UI on :8112. Set this to your router's LAN, e.g. 192.168.1.0/24 or
# 10.0.0.0/24. After changing it on a running server, recreate the
# containers: docker compose up -d --force-recreate vpn deluge
LOCAL_SUBNET=192.168.1.0/24

DNS_SUBDOMAINS=<your-duckdns-subdomain>
DNS_TOKEN=<your-duckdns-token>

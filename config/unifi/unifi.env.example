# UniFi gateway local API access for the port-forward reconciler (Step 11).
# Copy to config/unifi/unifi.env (gitignored) and fill in your values.
# Create the API key in UniFi Network 9+: Settings -> Control Plane ->
# Integrations. The installer puts this file on the server as
# /etc/mediaserver/unifi.env, root-only (0600).

# LAN address of the UniFi gateway (e.g. UDM / UDM Pro / UDM SE)
UNIFI_GATEWAY=192.168.1.1
UNIFI_API_KEY=<your-unifi-api-key>

# LAN IP of this server, i.e. the port-forward target. Reserve it in DHCP
# so it doesn't change.
MEDIA_IP=192.168.1.50
